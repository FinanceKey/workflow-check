{
  "name": "workflow-check",
  "version": "3.1.0",
  "description": "A GitHub Action that checks whether other workflows are running or queued on a given runner",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "test": "tsc && node --test \"lib/**/*.test.js\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "release": "release-it"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FinanceKey/workflow-check.git"
  },
  "keywords": [
    "actions",
    "node"
  ],
  "author": "Rony Meyer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FinanceKey/workflow-check/issues"
  },
  "homepage": "https://github.com/FinanceKey/workflow-check#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@octokit/auth-action": "^6.0.3",
    "@octokit/rest": "^22.0.1"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "release-it": "^21.1.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32"
}
